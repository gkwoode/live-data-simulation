# Copy to .env and uncomment what you want to change. Environment variables override this file,
# command-line flags override both, and changes made on the Sinks page are saved in data/state.json.

# --- server ---------------------------------------------------------------------------------
# LIVESIM_HOST=127.0.0.1            # 0.0.0.0 to allow other machines (set LIVESIM_API_KEY too)
# LIVESIM_PORT=8000
# LIVESIM_TCP_PORT=9999             # newline-delimited JSON firehose for Spark / netcat; 0 disables
# LIVESIM_PUBLIC_URL=               # e.g. https://my-tunnel.trycloudflare.com - used in connection snippets
# LIVESIM_API_KEY=                  # require a key on /api, /odata and /ws
# LIVESIM_ALLOWED_HOSTS=            # extra Host names to accept, comma separated ('*' accepts any)
# LIVESIM_LOG_LEVEL=info

# --- simulation -----------------------------------------------------------------------------
# LIVESIM_DATA_DIR=data             # SQLite store, landing zone and saved settings
# LIVESIM_SEED=42                   # seed for the reference (dim_*) tables
# LIVESIM_AUTOSTART=true            # start every stream on first launch
# LIVESIM_HISTORY_DAYS=2            # history generated into empty streams at start (0 disables)
# LIVESIM_MAX_ROWS=200000           # rows kept per stream in the SQLite store
# LIVESIM_ODATA_PAGE_SIZE=5000

# --- sinks (also configurable on the Sinks page) -----------------------------------------------
# LIVESIM_LAKE_ENABLED=false
# LIVESIM_LAKE_FORMAT=jsonl         # jsonl | csv | parquet (needs pyarrow)
# LIVESIM_LAKE_ROLL_SECONDS=60
# LIVESIM_LAKE_RETENTION_HOURS=24
# LIVESIM_SQL_URL=postgresql+psycopg://livesim:livesim@localhost:5432/livesim
# LIVESIM_SQL_SCHEMA=
# LIVESIM_KAFKA_BOOTSTRAP=localhost:19092
# LIVESIM_KAFKA_TOPIC_PREFIX=livesim.
# LIVESIM_KAFKA_TOPIC=              # one topic for every stream (e.g. an Event Hub name)
# LIVESIM_KAFKA_CONFIG={"security.protocol":"SASL_SSL","sasl.mechanisms":"PLAIN","sasl.username":"$ConnectionString","sasl.password":"Endpoint=sb://..."}
